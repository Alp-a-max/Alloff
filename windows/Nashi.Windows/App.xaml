   <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="None"><Border Background="{DynamicResource GlassPanel}" BorderBrush="{DynamicResource GlassEdge}" BorderThickness="1" CornerRadius="13" MinWidth="{TemplateBinding ActualWidth}" Padding="5"><ScrollViewer Background="Transparent" MaxHeight="300"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
